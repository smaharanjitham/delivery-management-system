	"paths": {
		"/fcm-token/save": {
			"post": {
				"operationId": "SaveToken",
				"responses": {
					"200": {
						"description": "Token saved",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SaveFcmTokenResponseDto"
								}
							}
						}
					}
				},
				"description": "Saves or refreshes a device's FCM token. Called by the app both\r\nright after login and whenever Firebase rotates the token\r\n(NotificationService.instance.onTokenRefresh in the Flutter app).",
				"tags": [
					"FCM Token"
				],
				"security": [
					{
						"BearerAuth": []
					}
				],
				"parameters": [],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SaveFcmTokenRequestDto"
							}
						}
					}
				}
			}
		},
		"/dashboard": {
			"get": {
				"operationId": "GetDashboard",
