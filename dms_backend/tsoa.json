{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": [
    "src/controllers/**/*.controller.ts"
  ],
  "spec": {
    "outputDirectory": "src/swagger",
    "specVersion": 3,
    "securityDefinitions": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "routes": {
    "routesDir": "src/routes-tsoa",
    "authenticationModule": "src/auth/authentication.ts"
  }
}